# EvoVerse SDK Stage-0 minimal interface -- t20f256-xd-ps-eval-stage0
# Auto-generated from the carrier pin map (do not edit by hand;
# add pins by editing the board pin map and regenerating).
# Board IO-bank voltages (board-level, from carrier ISF).
design.set_device_property("1A","VOLTAGE","3.3","IOBANK")
design.set_device_property("1B_1C","VOLTAGE","3.3","IOBANK")
design.set_device_property("1D_1E","VOLTAGE","3.3","IOBANK")
design.set_device_property("3A_3B_3C","VOLTAGE","3.3","IOBANK")
design.set_device_property("3D_3E","VOLTAGE","3.3","IOBANK")
design.set_device_property("4A","VOLTAGE","3.3","IOBANK")
design.set_device_property("4B","VOLTAGE","3.3","IOBANK")
# §15 bootstrap: create_* is a one-shot ritual for a peri.xml-less project.
# Unified Flow auto-infers these plain RTL-port GPIOs at map stage, so the
# create_* lines MUST stay commented for replay builds (otherwise
# "GPIO xxx exists"). Enable ONLY when bootstrapping without peri.xml.
# Trion T20F256 valid string is "3.3 V LVTTL / LVCMOS" (plain "3.3 V LVCMOS"
# fails gpio_rule_cfg_io_standard_valid).
# design.create_input_clock_gpio("clk_50m")
design.assign_pkg_pin("clk_50m","H13")
design.set_property("clk_50m","IO_STANDARD","3.3 V LVTTL / LVCMOS","GPIO")
# design.create_input_gpio("arst_n")
design.assign_pkg_pin("arst_n","A4")
design.set_property("arst_n","IO_STANDARD","3.3 V LVTTL / LVCMOS","GPIO")
# design.create_output_gpio("led_user")
design.assign_pkg_pin("led_user","T8")
design.set_property("led_user","IO_STANDARD","3.3 V LVTTL / LVCMOS","GPIO")
